---
import Icon from './ui/Icon.astro';
import type { IconName } from './ui/icons';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const points = [t('about.point1'), t('about.point2'), t('about.point3'), t('about.point4')];

const services: { icon: IconName; title: string; description: string }[] = [
  { icon: 'build', title: t('whatido.build.title'), description: t('whatido.build.desc') },
  { icon: 'bug', title: t('whatido.fix.title'), description: t('whatido.fix.desc') },
  { icon: 'speed', title: t('whatido.optimize.title'), description: t('whatido.optimize.desc') },
];
---

<section class="section about" id="about">
  <div class="container">
    <p class="about__kicker kicker reveal">01 · {t('nav.about')}</p>

    <div class="about__grid">
      <div class="about__intro reveal">
        <h2 class="about__title">{t('about.title')}</h2>

        <p class="about__lead">{t('about.intro')}</p>
        <p class="about__text">{t('about.experience')}</p>

        <ul class="about__points">
          {
            points.map((point) => (
              <li class="about__point">
                <span class="about__check"><Icon name="check" size={18} /></span>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="about__services-block reveal" style="transition-delay:0.15s">
        <p class="about__services-title">{t('whatido.title')}</p>
        <ul class="about__services">
          {
            services.map((service) => (
              <li class="about__service">
                <span class="about__service-icon">
                  <Icon name={service.icon} size={22} />
                </span>
                <div>
                  <h3 class="about__service-title">{service.title}</h3>
                  <p class="about__service-desc">{service.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about__kicker {
    margin-bottom: 32px;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: start;
  }

  .about__title {
    margin-bottom: 24px;
    font-weight: 500;
  }

  .about__lead {
    max-width: 52ch;
    margin-bottom: 20px;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text);
  }

  .about__text {
    max-width: 52ch;
    margin-bottom: 32px;
    color: var(--text-muted);
    font-size: 1.02rem;
  }

  .about__points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 24px;
    list-style: none;
  }

  .about__point {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--divider);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .about__check {
    display: inline-flex;
    color: var(--accent);
    flex-shrink: 0;
  }

  .about__services-title {
    margin-bottom: 16px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about__services {
    display: grid;
    list-style: none;
  }

  .about__service {
    display: flex;
    gap: 18px;
    padding-block: 22px;
    border-top: 1px solid var(--divider);
  }

  .about__service:last-child {
    border-bottom: 1px solid var(--divider);
  }

  .about__service-icon {
    display: inline-flex;
    padding-top: 2px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .about__service-title {
    margin-bottom: 4px;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .about__service-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 899px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 599px) {
    .about__points {
      grid-template-columns: 1fr;
    }
  }
</style>
