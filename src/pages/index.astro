---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { ui } from '../i18n/ui';

const lang = 'en' as const;
const t = ui[lang];
---

<BaseLayout
  title={t['meta.title']}
  description={t['meta.description']}
  lang={lang}
  alternates={[
    { lang: 'en', path: '/' },
    { lang: 'es', path: '/es/' },
  ]}
>
  <HomePage lang={lang} />
</BaseLayout>
