# Lead capture endpoint (n8n webhook)
# Workflow "Form Endpoint - Leads" on automations.d4lanis.com
# The ?site= query param identifies the client; it must exist (and be active) in the n8n Data Table "sites"
# Leads are stored in the n8n internal Data Table "leads"

VITE_LEAD_ENDPOINT=https://automations.d4lanis.com/webhook/form/lead?site=d4lanis
