# Lead capture endpoint (n8n webhook)
# Workflow "Form Endpoint - Leads" on automations.d4lanis.com
# Astro only exposes variables prefixed with PUBLIC_ to the client, so this one
# is embedded at build time and is safe to ship to the browser.
# The ?site= query param identifies the client; it must exist (and be active) in
# the n8n Data Table "sites".
# Leads are stored in the n8n internal Data Table "leads".

PUBLIC_LEAD_ENDPOINT=https://automations.d4lanis.com/webhook/form/lead?site=d4lanis
